{
  "name": "window-resizer-screenshot",
  "displayName": "__MSG_extensionName__",
  "version": "0.4.0",
  "description": "__MSG_extensionDescription__",
  "author": "uc4696",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "postbuild": "node scripts/copy-license.mjs",
    "prepackage": "node scripts/copy-license.mjs",
    "package": "plasmo package",
    "icon": "node scripts/generate-icon.js",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:install-browser": "node scripts/install-chrome.mjs",
    "test:e2e": "playwright test",
    "test:e2e:wsl": "wsl.exe -d Ubuntu -e bash scripts/e2e-wsl.sh",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts .claude/hooks *.config.ts *.config.mjs"
  },
  "dependencies": {
    "@plasmohq/storage": "1.15.0",
    "plasmo": "0.90.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@puppeteer/browsers": "3.2.5",
    "@types/chrome": "0.3.0",
    "@types/node": "22.13.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "svgo": "3.3.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.72.0"
  },
  "manifest": {
    "default_locale": "en",
    "permissions": [
      "activeTab",
      "storage",
      "downloads",
      "scripting"
    ],
    "commands": {
      "capture-visible-download": {
        "description": "__MSG_cmdCaptureVisibleDownload__"
      },
      "capture-visible-copy": {
        "description": "__MSG_cmdCaptureVisibleCopy__"
      },
      "capture-full-page-download": {
        "description": "__MSG_cmdCaptureFullPageDownload__"
      },
      "capture-full-page-copy": {
        "description": "__MSG_cmdCaptureFullPageCopy__"
      },
      "capture-pick": {
        "description": "__MSG_cmdCapturePick__"
      },
      "capture-visible-delay-3": {
        "description": "__MSG_cmdCaptureDelay3__"
      },
      "capture-visible-delay-5": {
        "description": "__MSG_cmdCaptureDelay5__"
      },
      "capture-visible-delay-10": {
        "description": "__MSG_cmdCaptureDelay10__"
      },
      "resize-preset-hd": {
        "description": "__MSG_cmdResizeHd__"
      },
      "resize-preset-wxga": {
        "description": "__MSG_cmdResizeWxga__"
      },
      "resize-preset-hdplus": {
        "description": "__MSG_cmdResizeHdplus__"
      },
      "resize-preset-fhd": {
        "description": "__MSG_cmdResizeFhd__"
      },
      "resize-preset-vga": {
        "description": "__MSG_cmdResizeVga__"
      },
      "resize-preset-svga": {
        "description": "__MSG_cmdResizeSvga__"
      },
      "resize-preset-xga": {
        "description": "__MSG_cmdResizeXga__"
      },
      "resize-preset-uxga": {
        "description": "__MSG_cmdResizeUxga__"
      },
      "resize-custom-1": {
        "description": "__MSG_cmdResizeCustom1__"
      },
      "resize-custom-2": {
        "description": "__MSG_cmdResizeCustom2__"
      },
      "resize-custom-3": {
        "description": "__MSG_cmdResizeCustom3__"
      },
      "resize-custom-4": {
        "description": "__MSG_cmdResizeCustom4__"
      },
      "resize-custom-5": {
        "description": "__MSG_cmdResizeCustom5__"
      }
    }
  },
  "allowScripts": {
    "lmdb": true,
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "sharp": true
  }
}
